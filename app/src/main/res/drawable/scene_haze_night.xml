<?xml version="1.0" encoding="utf-8"?>
<!-- Haze at night: a dim moon glows behind slow bands of haze. It moves for about 10 seconds each time the home screen shows it, then rests.
     The resting frame is the still picture below, which is all a phone with animations off shows. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="100dp"
            android:height="100dp"
            android:viewportWidth="100"
            android:viewportHeight="100">
            <group
                android:translateX="50"
                android:translateY="40">
                <group
                    android:name="moonGlow">
                    <path
                        android:name="moonGlowFill"
                        android:pathData="M-44,0a44,44 0 1,1 88,0a44,44 0 1,1 -88,0Z">
                        <aapt:attr name="android:fillColor">
                            <gradient
                                android:type="radial"
                                android:centerX="0"
                                android:centerY="0"
                                android:gradientRadius="44">
                                <item
                                    android:color="#8CF6F1C7"
                                    android:offset="0" />
                                <item
                                    android:color="#00F6F1C7"
                                    android:offset="1" />
                            </gradient>
                        </aapt:attr>
                    </path>
                </group>
            </group>
            <path
                android:name="star0"
                android:fillColor="#FFFFFF"
                android:pathData="M14.4,22a1.6,1.6 0 1,1 3.2,0a1.6,1.6 0 1,1 -3.2,0Z" />
            <path
                android:name="star1"
                android:fillColor="#FFFFFF"
                android:pathData="M84.6,30a1.4,1.4 0 1,1 2.8,0a1.4,1.4 0 1,1 -2.8,0Z" />
            <group
                android:translateX="0"
                android:translateY="-10"
                android:pivotX="50"
                android:pivotY="50"
                android:scaleX="1.1"
                android:scaleY="1.1">
                <path
                    android:fillColor="#EFE0B0"
                    android:pathData="M49,32A18,18 0 1,0 67,56A15,15 0 0,1 49,32Z" />
            </group>
            <group
                android:name="bar0">
                <path
                    android:fillColor="#D6C49C"
                    android:fillAlpha="0.6"
                    android:pathData="M20,58H86A3,3 0 0 1 86,64H20A3,3 0 0 1 20,58Z" />
            </group>
            <group
                android:name="bar1">
                <path
                    android:fillColor="#D6C49C"
                    android:fillAlpha="0.6"
                    android:pathData="M22,70H78A3,3 0 0 1 78,76H22A3,3 0 0 1 22,70Z" />
            </group>
            <group
                android:name="bar2">
                <path
                    android:fillColor="#D6C49C"
                    android:fillAlpha="0.6"
                    android:pathData="M18,82H82A3,3 0 0 1 82,88H18A3,3 0 0 1 18,82Z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="moonGlow">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="1"
                    android:valueTo="1.12"
                    android:valueType="floatType"
                    android:duration="2500"
                    android:repeatCount="3"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="1"
                    android:valueTo="1.12"
                    android:valueType="floatType"
                    android:duration="2500"
                    android:repeatCount="3"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="moonGlowFill">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="1"
                android:valueTo="0.7"
                android:valueType="floatType"
                android:duration="2500"
                android:repeatCount="3"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="star0">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="1"
                android:valueTo="0.3"
                android:valueType="floatType"
                android:duration="1250"
                android:repeatCount="5"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="star1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="1"
                android:valueTo="0.3"
                android:valueType="floatType"
                android:duration="1250"
                android:repeatCount="5"
                android:repeatMode="reverse"
                android:startOffset="500"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="bar0">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="translateX"
                android:valueFrom="0"
                android:valueTo="-6"
                android:valueType="floatType"
                android:duration="2500"
                android:repeatCount="3"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="bar1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="translateX"
                android:valueFrom="0"
                android:valueTo="6"
                android:valueType="floatType"
                android:duration="5000"
                android:repeatCount="1"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="bar2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="translateX"
                android:valueFrom="0"
                android:valueTo="-6"
                android:valueType="floatType"
                android:duration="2500"
                android:repeatCount="3"
                android:repeatMode="reverse"
                android:startOffset="400"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
</animated-vector>
