<?xml version="1.0" encoding="utf-8"?>
<!-- Sunny: the rays turn and the glow breathes. It moves for about 10 seconds each time the home screen shows it, then rests.
     The resting frame is the still picture below, which is all a phone with animations off shows. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="100dp"
            android:height="100dp"
            android:viewportWidth="100"
            android:viewportHeight="100">
            <group
                android:translateX="50"
                android:translateY="50">
                <group
                    android:name="sunGlow">
                    <path
                        android:name="sunGlowFill"
                        android:fillColor="#FFE9A8"
                        android:fillAlpha="0.4"
                        android:pathData="M-24.65,0a24.65,24.65 0 1,1 49.3,0a24.65,24.65 0 1,1 -49.3,0Z" />
                </group>
                <group
                    android:name="sunRays">
                    <path
                        android:strokeColor="#FFD866"
                        android:strokeWidth="3"
                        android:strokeLineCap="round"
                        android:pathData="M22.95,0L30.6,0M16.23,16.23L21.64,21.64M0,22.95L0,30.6M-16.23,16.23L-21.64,21.64M-22.95,0L-30.6,0M-16.23,-16.23L-21.64,-21.64M0,-22.95L0,-30.6M16.23,-16.23L21.64,-21.64" />
                </group>
                <path
                    android:fillColor="#FFC93C"
                    android:pathData="M-17,0a17,17 0 1,1 34,0a17,17 0 1,1 -34,0Z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="sunRays">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="135"
                android:valueType="floatType"
                android:duration="10000"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="sunGlow">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="1"
                    android:valueTo="1.12"
                    android:valueType="floatType"
                    android:duration="2500"
                    android:repeatCount="3"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="1"
                    android:valueTo="1.12"
                    android:valueType="floatType"
                    android:duration="2500"
                    android:repeatCount="3"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="sunGlowFill">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0.4"
                android:valueTo="0.65"
                android:valueType="floatType"
                android:duration="2500"
                android:repeatCount="3"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
</animated-vector>
