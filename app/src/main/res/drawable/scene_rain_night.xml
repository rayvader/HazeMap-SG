<?xml version="1.0" encoding="utf-8"?>
<!-- Rain at night: drops fall from a drifting cloud, with a glow where the moon hides. It moves for about 10 seconds each time the home screen shows it, then rests.
     The resting frame is the still picture below, which is all a phone with animations off shows. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="100dp"
            android:height="100dp"
            android:viewportWidth="100"
            android:viewportHeight="100">
            <group
                android:translateX="50"
                android:translateY="34">
                <group
                    android:name="moonGlow">
                    <path
                        android:name="moonGlowFill"
                        android:pathData="M-40,0a40,40 0 1,1 80,0a40,40 0 1,1 -80,0Z">
                        <aapt:attr name="android:fillColor">
                            <gradient
                                android:type="radial"
                                android:centerX="0"
                                android:centerY="0"
                                android:gradientRadius="40">
                                <item
                                    android:color="#8CF6F1C7"
                                    android:offset="0" />
                                <item
                                    android:color="#00F6F1C7"
                                    android:offset="1" />
                            </gradient>
                        </aapt:attr>
                    </path>
                </group>
            </group>
            <group
                android:translateX="53.6"
                android:translateY="46"
                android:scaleX="1.2"
                android:scaleY="1.2">
                <group
                    android:name="cloudFront">
                    <path
                        android:fillColor="#BDC8D8"
                        android:pathData="M-23,2a11,11 0 1,1 22,0a11,11 0 1,1 -22,0ZM-11,-6a14,14 0 1,1 28,0a14,14 0 1,1 -28,0ZM7,3a9,9 0 1,1 18,0a9,9 0 1,1 -18,0ZM-16,2H18A6,6 0 0 1 18,14H-16A6,6 0 0 1 -16,2Z" />
                </group>
            </group>
            <group
                android:name="drop0">
                <path
                    android:name="dropLine0"
                    android:strokeColor="#8DB6E6"
                    android:strokeWidth="3"
                    android:strokeLineCap="round"
                    android:pathData="M32,67L29,75" />
            </group>
            <group
                android:name="drop1">
                <path
                    android:name="dropLine1"
                    android:strokeColor="#8DB6E6"
                    android:strokeWidth="3"
                    android:strokeLineCap="round"
                    android:pathData="M45,67L42,75" />
            </group>
            <group
                android:name="drop2">
                <path
                    android:name="dropLine2"
                    android:strokeColor="#8DB6E6"
                    android:strokeWidth="3"
                    android:strokeLineCap="round"
                    android:pathData="M58,67L55,75" />
            </group>
            <group
                android:name="drop3">
                <path
                    android:name="dropLine3"
                    android:strokeColor="#8DB6E6"
                    android:strokeWidth="3"
                    android:strokeLineCap="round"
                    android:pathData="M71,67L68,75" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="moonGlow">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="1"
                    android:valueTo="1.12"
                    android:valueType="floatType"
                    android:duration="2500"
                    android:repeatCount="3"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="1"
                    android:valueTo="1.12"
                    android:valueType="floatType"
                    android:duration="2500"
                    android:repeatCount="3"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="moonGlowFill">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="1"
                android:valueTo="0.7"
                android:valueType="floatType"
                android:duration="2500"
                android:repeatCount="3"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="cloudFront">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="translateX"
                android:valueFrom="0"
                android:valueTo="-6"
                android:valueType="floatType"
                android:duration="2500"
                android:repeatCount="3"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="drop0">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueFrom="-6"
                    android:valueTo="10"
                    android:valueType="floatType"
                    android:duration="900"
                    android:repeatCount="9"
                    android:interpolator="@android:interpolator/linear" />
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueFrom="0"
                    android:valueTo="0"
                    android:valueType="floatType"
                    android:duration="1"
                    android:interpolator="@android:interpolator/linear" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="dropLine0">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="900"
                    android:repeatCount="9"
                    android:interpolator="@android:interpolator/linear">
                    <propertyValuesHolder android:propertyName="strokeAlpha" android:valueType="floatType">
                        <keyframe android:fraction="0" android:value="0" />
                        <keyframe android:fraction="0.3" android:value="1" />
                        <keyframe android:fraction="1" android:value="0" />
                    </propertyValuesHolder>
                </objectAnimator>
                <objectAnimator
                    android:propertyName="strokeAlpha"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:duration="400"
                    android:interpolator="@android:interpolator/decelerate_quad" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="drop1">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueFrom="-6"
                    android:valueTo="10"
                    android:valueType="floatType"
                    android:duration="900"
                    android:repeatCount="9"
                    android:startOffset="230"
                    android:interpolator="@android:interpolator/linear" />
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueFrom="0"
                    android:valueTo="0"
                    android:valueType="floatType"
                    android:duration="1"
                    android:interpolator="@android:interpolator/linear" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="dropLine1">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="900"
                    android:repeatCount="9"
                    android:startOffset="230"
                    android:interpolator="@android:interpolator/linear">
                    <propertyValuesHolder android:propertyName="strokeAlpha" android:valueType="floatType">
                        <keyframe android:fraction="0" android:value="0" />
                        <keyframe android:fraction="0.3" android:value="1" />
                        <keyframe android:fraction="1" android:value="0" />
                    </propertyValuesHolder>
                </objectAnimator>
                <objectAnimator
                    android:propertyName="strokeAlpha"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:duration="400"
                    android:interpolator="@android:interpolator/decelerate_quad" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="drop2">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueFrom="-6"
                    android:valueTo="10"
                    android:valueType="floatType"
                    android:duration="900"
                    android:repeatCount="9"
                    android:startOffset="460"
                    android:interpolator="@android:interpolator/linear" />
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueFrom="0"
                    android:valueTo="0"
                    android:valueType="floatType"
                    android:duration="1"
                    android:interpolator="@android:interpolator/linear" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="dropLine2">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="900"
                    android:repeatCount="9"
                    android:startOffset="460"
                    android:interpolator="@android:interpolator/linear">
                    <propertyValuesHolder android:propertyName="strokeAlpha" android:valueType="floatType">
                        <keyframe android:fraction="0" android:value="0" />
                        <keyframe android:fraction="0.3" android:value="1" />
                        <keyframe android:fraction="1" android:value="0" />
                    </propertyValuesHolder>
                </objectAnimator>
                <objectAnimator
                    android:propertyName="strokeAlpha"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:duration="400"
                    android:interpolator="@android:interpolator/decelerate_quad" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="drop3">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueFrom="-6"
                    android:valueTo="10"
                    android:valueType="floatType"
                    android:duration="900"
                    android:repeatCount="9"
                    android:startOffset="690"
                    android:interpolator="@android:interpolator/linear" />
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueFrom="0"
                    android:valueTo="0"
                    android:valueType="floatType"
                    android:duration="1"
                    android:interpolator="@android:interpolator/linear" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="dropLine3">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="900"
                    android:repeatCount="9"
                    android:startOffset="690"
                    android:interpolator="@android:interpolator/linear">
                    <propertyValuesHolder android:propertyName="strokeAlpha" android:valueType="floatType">
                        <keyframe android:fraction="0" android:value="0" />
                        <keyframe android:fraction="0.3" android:value="1" />
                        <keyframe android:fraction="1" android:value="0" />
                    </propertyValuesHolder>
                </objectAnimator>
                <objectAnimator
                    android:propertyName="strokeAlpha"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:duration="400"
                    android:interpolator="@android:interpolator/decelerate_quad" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
