<?xml version="1.0" encoding="utf-8"?>
<!-- Haze: a pale sun behind drifting bands of haze. It moves for about 10 seconds each time the home screen shows it, then rests.
     The resting frame is the still picture below, which is all a phone with animations off shows. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="100dp"
            android:height="100dp"
            android:viewportWidth="100"
            android:viewportHeight="100">
            <group
                android:translateX="50"
                android:translateY="40">
                <group
                    android:name="sunGlow">
                    <path
                        android:name="sunGlowFill"
                        android:fillColor="#FFE9A8"
                        android:fillAlpha="0.4"
                        android:pathData="M-21.75,0a21.75,21.75 0 1,1 43.5,0a21.75,21.75 0 1,1 -43.5,0Z" />
                </group>
                <group
                    android:name="sunRays">
                    <path
                        android:strokeColor="#FFD866"
                        android:strokeWidth="3"
                        android:strokeLineCap="round"
                        android:pathData="M20.25,0L27,0M14.32,14.32L19.09,19.09M0,20.25L0,27M-14.32,14.32L-19.09,19.09M-20.25,0L-27,0M-14.32,-14.32L-19.09,-19.09M0,-20.25L0,-27M14.32,-14.32L19.09,-19.09" />
                </group>
                <path
                    android:fillColor="#F2C46D"
                    android:pathData="M-15,0a15,15 0 1,1 30,0a15,15 0 1,1 -30,0Z" />
            </group>
            <group
                android:name="bar0">
                <path
                    android:fillColor="#F1E3C6"
                    android:fillAlpha="0.8"
                    android:pathData="M20,58H86A3,3 0 0 1 86,64H20A3,3 0 0 1 20,58Z" />
            </group>
            <group
                android:name="bar1">
                <path
                    android:fillColor="#F1E3C6"
                    android:fillAlpha="0.8"
                    android:pathData="M22,70H78A3,3 0 0 1 78,76H22A3,3 0 0 1 22,70Z" />
            </group>
            <group
                android:name="bar2">
                <path
                    android:fillColor="#F1E3C6"
                    android:fillAlpha="0.8"
                    android:pathData="M18,82H82A3,3 0 0 1 82,88H18A3,3 0 0 1 18,82Z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="sunRays">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="135"
                android:valueType="floatType"
                android:duration="10000"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="sunGlow">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="1"
                    android:valueTo="1.12"
                    android:valueType="floatType"
                    android:duration="2500"
                    android:repeatCount="3"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="1"
                    android:valueTo="1.12"
                    android:valueType="floatType"
                    android:duration="2500"
                    android:repeatCount="3"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="sunGlowFill">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0.4"
                android:valueTo="0.65"
                android:valueType="floatType"
                android:duration="2500"
                android:repeatCount="3"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="bar0">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="translateX"
                android:valueFrom="0"
                android:valueTo="-6"
                android:valueType="floatType"
                android:duration="2500"
                android:repeatCount="3"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="bar1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="translateX"
                android:valueFrom="0"
                android:valueTo="6"
                android:valueType="floatType"
                android:duration="5000"
                android:repeatCount="1"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="bar2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="translateX"
                android:valueFrom="0"
                android:valueTo="-6"
                android:valueType="floatType"
                android:duration="2500"
                android:repeatCount="3"
                android:repeatMode="reverse"
                android:startOffset="400"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
</animated-vector>
