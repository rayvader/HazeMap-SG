<?xml version="1.0" encoding="utf-8"?>
<!-- A cloud in the legend: the clouds' light grey fill and darker edge (see CloudLogic). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/cloud_fill" />
    <stroke
        android:width="1dp"
        android:color="@color/cloud_edge" />
    <corners android:radius="3dp" />
</shape>
