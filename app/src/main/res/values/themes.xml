<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HazeMap" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/teal_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">#B2DFDB</item>
        <item name="colorOnPrimaryContainer">#00201C</item>
        <item name="colorSecondaryContainer">#CCE8E4</item>
        <item name="colorOnSecondaryContainer">#05201D</item>
        <item name="android:colorBackground">#F6FAF9</item>
        <item name="colorSurface">#F6FAF9</item>
        <item name="colorOnSurface">#171D1C</item>
        <item name="colorSurfaceVariant">#DAE5E2</item>
        <item name="colorOnSurfaceVariant">#3F4947</item>
        <item name="colorOutline">#6F7977</item>
        <item name="colorOutlineVariant">#BFC9C6</item>
        <item name="colorSurfaceContainer">#EAEFED</item>
        <item name="android:statusBarColor">@color/teal_700</item>
    </style>

    <!-- Small caps heading at the top of a card. -->
    <style name="CardLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
</resources>
