<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- White text with a soft shadow, readable on every sky colour. -->
    <style name="WidgetText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:shadowColor">#73000000</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">3</item>
    </style>

    <!-- The PSI number as a coloured pill; the app sets the colour for the PSI band. -->
    <style name="WidgetPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/widget_badge_none</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
