<?xml version="1.0" encoding="utf-8"?>
<!-- Sky scene, square: the sky colour and the moving picture follow the weather; the clock ticks by itself. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_sky_partly">

    <!-- One moving weather picture per scene; the app shows one and hides the others.
         A progress bar is the one view a widget can animate: it plays its picture by itself.
         The default progress bar style caps the size at 48dp, so each sets its own limits, and
         multiplying by white keeps the colours on phones whose style tints progress bars. -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp">
        <ProgressBar
            android:id="@+id/wSceneSun"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/scene_sun"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="multiply"
            android:maxWidth="64dp"
            android:maxHeight="64dp"
            android:minWidth="64dp"
            android:minHeight="64dp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/wScenePartly"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/scene_partly"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="multiply"
            android:maxWidth="64dp"
            android:maxHeight="64dp"
            android:minWidth="64dp"
            android:minHeight="64dp" />
        <ProgressBar
            android:id="@+id/wSceneCloud"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/scene_cloud"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="multiply"
            android:maxWidth="64dp"
            android:maxHeight="64dp"
            android:minWidth="64dp"
            android:minHeight="64dp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/wSceneRain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/scene_rain"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="multiply"
            android:maxWidth="64dp"
            android:maxHeight="64dp"
            android:minWidth="64dp"
            android:minHeight="64dp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/wSceneStorm"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/scene_storm"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="multiply"
            android:maxWidth="64dp"
            android:maxHeight="64dp"
            android:minWidth="64dp"
            android:minHeight="64dp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/wSceneHaze"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/scene_haze"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="multiply"
            android:maxWidth="64dp"
            android:maxHeight="64dp"
            android:minWidth="64dp"
            android:minHeight="64dp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/wSceneWind"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/scene_wind"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="multiply"
            android:maxWidth="64dp"
            android:maxHeight="64dp"
            android:minWidth="64dp"
            android:minHeight="64dp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/wSceneNight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/scene_night"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="multiply"
            android:maxWidth="64dp"
            android:maxHeight="64dp"
            android:minWidth="64dp"
            android:minHeight="64dp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/wScenePartlyNight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/scene_partly_night"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="multiply"
            android:maxWidth="64dp"
            android:maxHeight="64dp"
            android:minWidth="64dp"
            android:minHeight="64dp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/wSceneCloudNight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/scene_cloud_night"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="multiply"
            android:maxWidth="64dp"
            android:maxHeight="64dp"
            android:minWidth="64dp"
            android:minHeight="64dp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/wSceneRainNight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/scene_rain_night"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="multiply"
            android:maxWidth="64dp"
            android:maxHeight="64dp"
            android:minWidth="64dp"
            android:minHeight="64dp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/wSceneStormNight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/scene_storm_night"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="multiply"
            android:maxWidth="64dp"
            android:maxHeight="64dp"
            android:minWidth="64dp"
            android:minHeight="64dp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/wSceneHazeNight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/scene_haze_night"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="multiply"
            android:maxWidth="64dp"
            android:maxHeight="64dp"
            android:minWidth="64dp"
            android:minHeight="64dp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/wSceneWindNight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/scene_wind_night"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="multiply"
            android:maxWidth="64dp"
            android:maxHeight="64dp"
            android:minWidth="64dp"
            android:minHeight="64dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- The clock and the date. Its top space is padding, because the app trims it on a short widget. -->
    <LinearLayout
        android:id="@+id/wTopBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp">

        <TextClock
            android:id="@+id/wClock"
            style="@style/WidgetText"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:textSize="32sp" />

        <TextClock
            android:id="@+id/wDate"
            style="@style/WidgetText"
            android:format12Hour="EEE d MMM"
            android:format24Hour="EEE d MMM"
            android:textSize="11sp"
            android:layout_marginStart="1dp"
            android:layout_marginTop="1dp" />
    </LinearLayout>

    <!-- The next event, the temperature, the place and the PSI. Its bottom space is trimmed on a short widget. -->
    <LinearLayout
        android:id="@+id/wBottomBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <!-- The next event on the chosen calendars. Hidden until there is one. -->
        <LinearLayout
            android:id="@+id/wEventRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/widget_event_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="9dp"
            android:paddingBottom="2dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/wEventIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_event"
                android:tint="@color/white" />

            <!-- A long title ends in "…" when the row runs out of room. -->
            <TextView
                android:id="@+id/wEventText"
                style="@style/WidgetText"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="--"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/wTemp"
                style="@style/WidgetText"
                android:fontFamily="sans-serif-light"
                android:text="@string/no_temp"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/wCondition"
                style="@style/WidgetText"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="--"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/wPlace"
            style="@style/WidgetText"
            android:alpha="0.92"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="--"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/wBadge"
                style="@style/WidgetPill"
                android:text="@string/widget_psi_none" />

            <TextView
                android:id="@+id/wWhen"
                style="@style/WidgetText"
                android:alpha="0.92"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="--"
                android:textSize="11sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
