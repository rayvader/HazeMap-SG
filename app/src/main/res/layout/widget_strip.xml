<?xml version="1.0" encoding="utf-8"?>
<!-- Sky scene, one row: clock, moving picture, weather, then the PSI and its time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_sky_partly"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/wClock"
            style="@style/WidgetText"
            android:fontFamily="sans-serif-light"
            android:format12Hour="h:mm"
            android:format24Hour="H:mm"
            android:includeFontPadding="false"
            android:textSize="28sp" />

        <TextClock
            android:id="@+id/wDate"
            style="@style/WidgetText"
            android:format12Hour="EEE d MMM"
            android:format24Hour="EEE d MMM"
            android:textSize="10sp"
            android:layout_marginStart="1dp" />
    </LinearLayout>

    <!-- One moving weather picture per scene; the app shows one and hides the others.
         A progress bar is the one view a widget can animate: it plays its picture by itself.
         The default progress bar style caps the size at 48dp, so each sets its own limits, and
         multiplying by white keeps the colours on phones whose style tints progress bars. -->
    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginStart="8dp">
        <ProgressBar
            android:id="@+id/wSceneSun"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/scene_sun"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="multiply"
            android:maxWidth="46dp"
            android:maxHeight="46dp"
            android:minWidth="46dp"
            android:minHeight="46dp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/wScenePartly"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/scene_partly"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="multiply"
            android:maxWidth="46dp"
            android:maxHeight="46dp"
            android:minWidth="46dp"
            android:minHeight="46dp" />
        <ProgressBar
            android:id="@+id/wSceneCloud"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/scene_cloud"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="multiply"
            android:maxWidth="46dp"
            android:maxHeight="46dp"
            android:minWidth="46dp"
            android:minHeight="46dp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/wSceneRain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/scene_rain"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="multiply"
            android:maxWidth="46dp"
            android:maxHeight="46dp"
            android:minWidth="46dp"
            android:minHeight="46dp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/wSceneStorm"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/scene_storm"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="multiply"
            android:maxWidth="46dp"
            android:maxHeight="46dp"
            android:minWidth="46dp"
            android:minHeight="46dp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/wSceneHaze"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/scene_haze"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="multiply"
            android:maxWidth="46dp"
            android:maxHeight="46dp"
            android:minWidth="46dp"
            android:minHeight="46dp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/wSceneWind"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/scene_wind"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="multiply"
            android:maxWidth="46dp"
            android:maxHeight="46dp"
            android:minWidth="46dp"
            android:minHeight="46dp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/wSceneNight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/scene_night"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="multiply"
            android:maxWidth="46dp"
            android:maxHeight="46dp"
            android:minWidth="46dp"
            android:minHeight="46dp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/wTemp"
                style="@style/WidgetText"
                android:fontFamily="sans-serif-light"
                android:text="@string/no_temp"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/wCondition"
                style="@style/WidgetText"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="--"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/wPlace"
            style="@style/WidgetText"
            android:alpha="0.92"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="--"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wBadge"
            style="@style/WidgetPill"
            android:text="@string/widget_psi_none" />

        <TextView
            android:id="@+id/wWhen"
            style="@style/WidgetText"
            android:alpha="0.92"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="--"
            android:textSize="10sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
