<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Android 10 and newer: "Follow my location" on the widgets, which refresh while the app is closed.
         Asked only when the switch is turned on; the phone's last known approximate location is read, nothing more. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- The app installs its own updates. Android asks the person before allowing this. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12 and newer: later updates of this app can install with no tap. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- The widget line shows the next event from the calendars ticked in the app. Android asks first.
         Event details stay on the phone. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Whether a Calendar app can open an event tapped on the widget line. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.cursor.item/event" />
        </intent>
    </queries>

    <application
        android:name=".HazeApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HazeMap">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PlaceActivity"
            android:exported="false" />

        <!-- The screen a widget opens when it is added or reconfigured. The launcher starts it with the
             widget's id, and it ignores any id that is not one of this app's own widgets. -->
        <activity
            android:name=".WidgetPlaceActivity"
            android:exported="true"
            android:label="@string/widget_pick_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".HazeWidgetSmall"
            android:exported="false"
            android:label="@string/widget_label_small">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_small_info" />
        </receiver>

        <receiver
            android:name=".HazeWidgetWide"
            android:exported="false"
            android:label="@string/widget_label_wide">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_wide_info" />
        </receiver>

        <receiver
            android:name=".HazeWidgetStrip"
            android:exported="false"
            android:label="@string/widget_label_strip">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_strip_info" />
        </receiver>

        <receiver
            android:name=".UpdateStatusReceiver"
            android:exported="false" />

        <!-- Which calendars the widget line reads. Opened from the widget's own screen. -->
        <activity
            android:name=".CalendarsActivity"
            android:exported="false"
            android:label="@string/calendars_title" />

        <!-- Redraws the widgets when the shown event starts or ends. -->
        <receiver
            android:name=".WidgetRefreshReceiver"
            android:exported="false" />

        <!-- The calendar provider tells every app when a calendar changes, so the line stays current.
             Anyone could send this; it only asks for a redraw. -->
        <receiver
            android:name=".CalendarChangedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PROVIDER_CHANGED" />
                <data
                    android:host="com.android.calendar"
                    android:scheme="content" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
